# BEGIN cPanel-generated php ini directives
<IfModule php8_module>
   php_value error_log "/home/hz18jx9b/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/hz18jx9b/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives

# Configuração Apache / LiteSpeed para Hostoo, Hostinger e cPanel
# Japa Intermediações - Sistema Automotivo PHP

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Roteamento de todas as chamadas /api para a API PHP
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
    RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

    # 2. Servir arquivos e pastas existentes diretamente (CSS, JS, imagens, logo.jpg)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Rota dinâmica de veículos para SEO Social (Meta / WhatsApp / Facebook / Twitter)
    RewriteRule ^veiculo/([^/]+)/?$ veiculo.php?id=$1 [QSA,L]

    # 4. Suporte a parâmetro de busca ?veiculo=...
    RewriteCond %{QUERY_STRING} (?:^|&)veiculo=([^&]+) [NC]
    RewriteRule ^$ veiculo.php?id=%1 [L]

    # 5. Qualquer outra rota (ex: /admin, /estoque...) vai para o index.html da aplicação
    RewriteRule ^ index.html [L]
</IfModule>

# Bloqueio de arquivos sensíveis
<FilesMatch "^\.(env|git|htaccess|htpasswd)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Otimização de Cache e Compressão
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Desabilitar cache no index.html para que atualizações apareçam instantaneamente no navegador
<FilesMatch "^(index\.html)?$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# Charset padrão UTF-8
AddDefaultCharset UTF-8
